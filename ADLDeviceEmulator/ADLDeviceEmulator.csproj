<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ADLDeviceEmulator</RootNamespace>
    <AssemblyName>ADLDeviceEmulator</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="DeviceEditorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DeviceEditorForm.Designer.cs">
      <DependentUpon>DeviceEditorForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
